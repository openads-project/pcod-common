[flake8]
extend-ignore = D100, D202, D400, D401, E203
import-order-style = smarkets
max-line-length = 130
show-source = true
statistics = true
inline-quotes = double
multiline-quotes = double
docstring-quotes = double

# flake8-import-order's stdlib list predates Python 3.11's tomllib.
per-file-ignores =
    scripts/check_versions.py:I100,I201
