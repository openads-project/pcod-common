{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pcod-common/model_manifest.schema.json",
  "title": "PCOD Model Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact", "frozen_contract", "runtime_defaults"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_name",
        "export_format",
        "backend",
        "precision",
        "device",
        "files",
        "triton",
        "inputs",
        "outputs"
      ],
      "properties": {
        "bundle_name": { "type": "string" },
        "export_format": { "type": "string" },
        "backend": { "type": "string" },
        "precision": { "type": "string" },
        "device": { "type": "string" },
        "head_name": { "type": "string" },
        "export_timestamp_utc": { "type": "string" },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkpoint", "resolved_training_config"],
          "properties": {
            "model": { "type": "string" },
            "checkpoint": { "type": "string" },
            "resolved_training_config": { "type": "string" },
            "triton_repository": { "type": "string" },
            "triton_config": { "type": "string" },
            "triton_model": { "type": "string" }
          }
        },
        "triton": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "model_name": { "type": "string" },
            "model_version": { "type": ["string", "integer"] }
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "dtype", "shape"],
            "properties": {
              "name": { "type": "string" },
              "dtype": { "type": "string" },
              "shape": {
                "type": "array",
                "items": { "type": ["string", "integer"] }
              },
              "description": { "type": "string" }
            }
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "dtype", "shape"],
            "properties": {
              "name": { "type": "string" },
              "dtype": { "type": "string" },
              "shape": {
                "type": "array",
                "items": { "type": ["string", "integer"] }
              },
              "description": { "type": "string" }
            }
          }
        },
        "size_priors": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "size_priors_source": { "type": "string" }
      }
    },
    "frozen_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preprocessing", "postprocessing", "model"],
      "properties": {
        "preprocessing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_num_points",
            "num_point_features",
            "point_cloud_range",
            "voxel_size",
            "point_feature_normalization"
          ],
          "properties": {
            "max_num_points": { "type": "integer", "minimum": 1 },
            "num_point_features": { "type": "integer", "minimum": 1 },
            "point_cloud_range": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "z"],
              "properties": {
                "x": { "$ref": "#/definitions/range2" },
                "y": { "$ref": "#/definitions/range2" },
                "z": { "$ref": "#/definitions/range2" }
              }
            },
            "voxel_size": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "z"],
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" },
                "z": { "type": "number" }
              }
            },
            "point_feature_normalization": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "epsilon"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["none", "value_threshold", "min_max", "z_score"]
                },
                "min_value": { "type": "number" },
                "max_value": { "type": "number" },
                "epsilon": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          }
        },
        "postprocessing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grid_size", "num_classes", "class_names"],
          "properties": {
            "grid_size": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": { "type": "integer", "minimum": 1 },
                "y": { "type": "integer", "minimum": 1 }
              }
            },
            "num_classes": { "type": "integer", "minimum": 1 },
            "class_names": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stride",
            "up_stride",
            "first_up_stride",
            "pillar_map_size",
            "pillar_map_range"
          ],
          "properties": {
            "stride": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1 },
              "minItems": 1
            },
            "up_stride": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1 },
              "minItems": 1
            },
            "first_up_stride": { "type": "integer", "minimum": 1 },
            "pillar_map_size": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1 },
              "minItems": 2,
              "maxItems": 2
            },
            "pillar_map_range": {
              "type": "array",
              "items": { "$ref": "#/definitions/range2" },
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      }
    },
    "runtime_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preprocessing", "postprocessing"],
      "properties": {
        "preprocessing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["point_feature"],
          "properties": {
            "point_feature": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value_threshold": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          }
        },
        "postprocessing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class_score_threshold", "nms"],
          "properties": {
            "class_score_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "nms": {
              "type": "object",
              "additionalProperties": false,
              "required": ["score_threshold", "iou_threshold", "max_num_objects"],
              "properties": {
                "score_threshold": {
                  "type": ["number", "array"]
                },
                "iou_threshold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "max_num_objects": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "range2": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    }
  }
}
