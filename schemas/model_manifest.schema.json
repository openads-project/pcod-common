{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pcod-common/model_manifest.schema.json",
  "title": "PCOD Model Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "model_name",
    "precision",
    "device",
    "preprocessing",
    "postprocessing",
    "model"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "model_name": { "type": "string" },
    "precision": { "type": "string" },
    "device": { "type": "string" },
    "preprocessing": {
      "type": "object",
      "required": ["max_num_points", "num_point_features", "point_cloud_range", "voxel_size"],
      "properties": {
        "max_num_points": { "type": "integer", "minimum": 1 },
        "num_point_features": { "type": "integer", "minimum": 1 },
        "point_cloud_range": {
          "type": "object",
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            "y": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            "z": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
          }
        },
        "voxel_size": {
          "type": "object",
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          }
        }
      }
    },
    "postprocessing": {
      "type": "object",
      "required": ["grid_size", "num_classes", "class_names", "nms_iou_threshold", "score_threshold", "max_detections"],
      "properties": {
        "grid_size": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "integer", "minimum": 1 },
            "y": { "type": "integer", "minimum": 1 }
          }
        },
        "num_classes": { "type": "integer", "minimum": 1 },
        "class_names": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "nms_iou_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "score_threshold": { "type": ["number", "array"] },
        "max_detections": { "type": "integer", "minimum": 1 },
        "with_velocity": { "type": "boolean" }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "stride",
        "up_stride",
        "first_up_stride",
        "pillar_map_size",
        "pillar_map_range",
        "mask_is_bool",
        "zero_intensity"
      ],
      "properties": {
        "stride": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
        "up_stride": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
        "first_up_stride": { "type": "integer", "minimum": 1 },
        "pillar_map_size": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "pillar_map_range": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "minItems": 3,
          "maxItems": 3
        },
        "mask_is_bool": { "type": "boolean" },
        "zero_intensity": { "type": "boolean" }
      }
    },
    "triton": {
      "type": "object",
      "properties": {
        "model_name": { "type": "string" },
        "model_version": { "type": "string" },
        "precision": { "type": "string" }
      }
    }
  }
}
