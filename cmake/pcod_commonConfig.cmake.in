@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if("@PCOD_COMMON_CONFIG_YAML_CPP_TARGET@" STREQUAL "PkgConfig::YAML_CPP")
  find_dependency(PkgConfig)
  pkg_check_modules(YAML_CPP REQUIRED IMPORTED_TARGET yaml-cpp)
else()
  find_dependency(yaml-cpp CONFIG)
endif()

if(@PCOD_COMMON_CONFIG_WITH_CUDA@)
  find_dependency(CUDAToolkit)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/pcod_commonTargets.cmake")
check_required_components(pcod_common)
